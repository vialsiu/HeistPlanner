<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="RestSharp" Version="114.0.0" />
    </ItemGroup>

    <!--ref to exclude files from the build - https://learn.microsoft.com/en-us/visualstudio/msbuild/how-to-exclude-files-from-the-build -->
    <!-- The test project sits inside this folder, so stop the web app from compiling the test files -->
    <ItemGroup>
        <Compile Remove="HeistPlanner.UnitTests\**" />
        <Content Remove="HeistPlanner.UnitTests\**" />
        <EmbeddedResource Remove="HeistPlanner.UnitTests\**" />
        <None Remove="HeistPlanner.UnitTests\**" />
    </ItemGroup>

</Project>