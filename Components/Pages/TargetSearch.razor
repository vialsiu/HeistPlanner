@* -----reference @inject gives this component the shared HeistPlan https://learn.microsoft.com/en-us/aspnet/core/blazor/fundamentals/dependency-injection *@
@inject HeistPlan Plan

@*----3 columns: steps on the left, search and artworks in the middle, target list on the right
----all 3 are in this one component so the target list updates straight away when you add something *@
<div class="page-layout">

    <aside class="side-col steps-col">
        <StepsPanel/>
    </aside>

    <section class="results-col" id="collection">
        <div class="search-bar">
            <label for="artwork-search">Search the collection</label>
            <div class="search-row">
                <input id="artwork-search" placeholder="Artist, title or keyword..." @bind="searchText"/>
                <button class="btn-heist" @onclick="Search">Search</button>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <p class="text-danger">@errorMessage</p>
        }

        <div class="results-header">
            @if (showingFeatured)
            {
                <h2>Featured from the collection</h2>
                <p class="results-count">@artworks.Count works · sorted by title</p>
            }
            else
            {
                <h2>Search results</h2>
                <p class="results-count">
                    @artworks.Count works for "@lastSearch" ·
                    <button class="link-btn" @onclick="LoadFeatured">Show featured works again</button>
                </p>
            }
        </div>

        @if (!showingFeatured && errorMessage == null && artworks.Count == 0)
        {
            <p class="empty-text">No artworks found for "@lastSearch". Try another artist or keyword.</p>
        }

        <div class="artwork-grid">
            @foreach (var artwork in artworks)
            {
                bool chosen = Plan.IsTarget(artwork);
                <div class="artwork-card @(chosen ? "chosen" : "")">
                    @*---the painting itself is the button, click to add it and click again to take it off the list *@
                    @*----ref aria-pressed tells screen readers the button is switched on or off https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Attributes/aria-pressed *@
                    <button class="card-image" @onclick="() => ToggleTarget(artwork)" aria-pressed="@(chosen ? "true" : "false")" aria-label="@(chosen ? "Remove" : "Add") @artwork.Title">
                        @if (artwork.ImageUrl != "" && !failedImages.Contains(artwork.Id))
                        {
                            @*----reference for blazor @onerror event https://learn.microsoft.com/en-us/aspnet/core/blazor/components/event-handling *@
                            <img src="@artwork.ImageUrl" alt="" @onerror="() => ImageFailed(artwork)"/>
                        }
                        else
                        {
                            //-- when there's no image
                            <span class="no-image">Image not on display</span>
                        }

                        @if (chosen)
                        {
                            <span class="card-badge">✓ On the list</span>
                        }

                        @*---only shows when you hover over the painting *@
                        <span class="card-overlay">@(chosen ? "✕ Remove from the list" : "+ Add to the list")</span>
                    </button>

                    @*---square painting with the name in bold and the made up value under it *@
                    <div class="card-text">
                        <span class="card-title">@artwork.Title</span>
                        <span class="card-price">@HeistSimulator.FormatMoney(HeistSimulator.EstimateValue(artwork))</span>
                    </div>
                </div>
            }
        </div>
    </section>

    <aside class="side-col list-col">
        <div class="ledger">
            <p class="ledger-eyebrow">Acquisitions, unofficial</p>
            <h2>The List</h2>
            <p class="ledger-count">@Plan.Targets.Count of @HeistPlan.MAX_TARGETS pieces</p>

            <ul>
                @foreach (var target in Plan.Targets)
                {
                    <li>
                        @if (target.ImageUrl != "" && !failedImages.Contains(target.Id))
                        {
                            <img class="ledger-thumb" src="@target.ImageUrl" alt=""/>
                        }
                        else
                        {
                            <div class="ledger-thumb"></div>
                        }
                        <div class="ledger-text">
                            <span class="ledger-title">@target.Title</span>
                            <span class="ledger-artist">@target.Artist</span>
                        </div>
                        <button class="link-btn" aria-label="Remove @target.Title" @onclick="() => RemoveTarget(target)">Remove</button>
                    </li>
                }

                @*----one dashed box for every space left *@
                @for (int i = Plan.Targets.Count; i < HeistPlan.MAX_TARGETS; i++)
                {
                    <li class="empty-slot">Space in the van</li>
                }
            </ul>

            @if (targetMessage != null)
            {
                <p class="target-warning">@targetMessage</p>
            }

            <a href="crew" class="btn-heist next-link">Next: recruit the crew</a>
        </div>
    </aside>

</div>

@code {
    private string? searchText;
    private string? errorMessage;
    private List<Artwork> artworks = new();
    private bool showingFeatured = true;
    private string? lastSearch;
    private List<int> failedImages = new();
    private string? targetMessage;

    //----ref OnInitialized runs when the page first loads so the featured works are there before any search - https://learn.microsoft.com/en-us/aspnet/core/blazor/components/lifecycle
    protected override void OnInitialized()
    {
        LoadFeatured();
    }

    private void LoadFeatured()
    {
        errorMessage = null;
        showingFeatured = true;
        try
        {
            artworks = ArtworkService.GetFeaturedArtworks();
            artworks.Sort();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
            artworks = new List<Artwork>();
        }
    }

    private void Search()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(searchText))
        {
            errorMessage = "Type something to search for.";
            return;
        }

        showingFeatured = false;
        lastSearch = searchText;
        try
        {
            artworks = ArtworkService.SearchArtworks(searchText);
            artworks.Sort();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ImageFailed(Artwork artwork)
    {
        if (!failedImages.Contains(artwork.Id))
        {
            failedImages.Add(artwork.Id);
        }
    }

    //---clicking the painting adds it, clicking it again takes it off
    private void ToggleTarget(Artwork artwork)
    {
        if (Plan.IsTarget(artwork))
        {
            RemoveTarget(artwork);
        }
        else
        {
            AddTarget(artwork);
        }
    }

    //---the rules now live in HeistPlan the page just shows the message it gets back
    private void AddTarget(Artwork artwork)
    {
        targetMessage = Plan.AddTarget(artwork);
    }

    private void RemoveTarget(Artwork artwork)
    {
        Plan.RemoveTarget(artwork);
        targetMessage = null;
    }
}