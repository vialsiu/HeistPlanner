<h3>Scout the targets</h3>

<input placeholder="Search artworks..." @bind="searchText"/>
<button @onclick="Search">Search</button>

@if (errorMessage != null)
{
    <p class="text-danger">@errorMessage</p>
}

@if (hasSearched && errorMessage == null && artworks.Count == 0)
{
    <p>No artworks found for "@lastSearch". Try another artist or keyword.</p>
}


<div class="artwork-grid">
    @foreach (var artwork in artworks)
    {
        <div class="artwork-card">
            @if (artwork.ImageUrl != "" && !failedImages.Contains(artwork.Id))
            {
                @* Ref: Blazor @onerror event - https://learn.microsoft.com/en-us/aspnet/core/blazor/components/event-handling *@
                <img src="@artwork.ImageUrl" alt="@artwork.Title" @onerror="() => ImageFailed(artwork)"/>
            }
            else
            {
                //-- when there's no image
                <div class="no-image">No image available</div>
            }
            <div class="artwork-info">
                <h5>@artwork.Title</h5>
                <p>@artwork.Artist · @artwork.DateDisplay</p>
                <p class="small-text">@artwork.Dimensions</p>
            </div>
        </div>
    }
</div>

@code {
    private string? searchText;
    private string? errorMessage;
    private List<Artwork> artworks = new();
    private bool hasSearched = false;
    private string? lastSearch;
    private List<int> failedImages = new();

    private void Search()
    {
        errorMessage = null;
        hasSearched = true;
        lastSearch = searchText;
        if (string.IsNullOrWhiteSpace(searchText))
        {
            errorMessage = "Type something to search for.";
            return;
        }

        try
        {
            artworks = ArtworkService.SearchArtworks(searchText);
            artworks.Sort();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ImageFailed(Artwork artwork)
    {
        if (!failedImages.Contains(artwork.Id))
        {
            failedImages.Add(artwork.Id);
        }
    }
}