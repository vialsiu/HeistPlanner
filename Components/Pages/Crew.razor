@page "/crew"
@* ----ref @inject gets the same HeistPlan the targets page uses https://learn.microsoft.com/en-us/aspnet/core/blazor/fundamentals/dependency-injection *@
@inject HeistPlan Plan

<PageTitle>Crew - Heist Planner</PageTitle>

@* ---painting band at the top, same as the targets page (styles in app.css) *@
<PageHero PaintingClass="hero-crew" Eyebrow="Recruitment" Title="Assemble the Crew" LinkTarget="#crew" LinkText="Five roles, one specialist each"/>

@* ---3 columns: steps on the left, crew and candidates in the middle, payroll on the right *@
<div class="page-layout">

    <aside class="side-col steps-col">
        <StepsPanel/>
    </aside>

    <section class="crew-main" id="crew">
        <div class="section-header">
            <h2>Your crew</h2>
            <p class="section-count">@Plan.Crew.Count of @roles.Length seats filled</p>
        </div>

        <div class="crew-grid">
            @foreach (CrewRole role in roles)
            {
                CrewMember? member = Plan.GetCrewMember(role);
                if (member != null)
                {
                    <div class="crew-card hired">
                        <span class="role-label">@CrewMember.GetRoleName(role)</span>
                        <div class="person">
                            <img src="@member.PhotoUrl" alt="@member.Name"/>
                            <div>
                                <span class="person-name">@member.Name</span>
                                <span class="small-text">@member.Country · @member.Age</span>
                            </div>
                        </div>
                        <div class="skill-row">
                            <span>Skill</span>
                            <span>@member.Skill</span>
                        </div>
                        <div class="skill-bar">
                            @* ----ref @( ) explicit razor expression so the number goes right before the % https://learn.microsoft.com/en-us/aspnet/core/mvc/views/razor#explicit-razor-expressions *@
                            <div style="width: @(member.Skill)%"></div>
                        </div>
                        <p class="perk">@member.Perk</p>
                        <p class="small-text">Takes @member.GetCutPercentage()% of the loot</p>
                        <button class="btn-heist-outline fire-btn" @onclick="() => Fire(role)">Fire</button>
                    </div>
                }
                else
                {
                    <div class="crew-card empty">
                        <span class="role-label">@CrewMember.GetRoleName(role)</span>
                        <span class="empty-title">Seat empty</span>
                        <span class="small-text">Hire someone from the candidates below</span>
                    </div>
                }
            }
        </div>

        <div class="section-header candidates-header">
            <h2>Candidates for hire</h2>
            <div class="hire-controls">
                <label for="hire-role">Hire as</label>
                @* ----ref @bind on a select, the dropdown value goes straight into selectedRole https://learn.microsoft.com/en-us/aspnet/core/blazor/components/data-binding *@
                <select id="hire-role" @bind="selectedRole">
                    @foreach (CrewRole role in roles)
                    {
                        <option value="@role">@CrewMember.GetRoleName(role)</option>
                    }
                </select>
                <button class="btn-heist-outline" @onclick="LoadCandidates">New candidates</button>
            </div>
        </div>

        @if (hireMessage != null)
        {
            <p class="hire-message">@hireMessage</p>
        }

        @if (errorMessage != null)
        {
            <p class="text-danger">@errorMessage</p>
        }

        @if (errorMessage == null && candidates.Count == 0)
        {
            <p class="small-text">No candidates left. Click "New candidates" to get more.</p>
        }

        @* ---the table scrolls sideways on small screens instead of squashing *@
        <div class="table-wrap">
            <table class="candidates">
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Country</th>
                        <th>Age</th>
                        <th>Rated skill</th>
                        <th><span class="visually-hidden">Hire</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in candidates)
                    {
                        <tr>
                            <td>
                                <div class="candidate-name">
                                    <img src="@person.picture.large" alt=""/>
                                    <span>@person.name.first @person.name.last</span>
                                </div>
                            </td>
                            <td>@person.location.country</td>
                            <td>@person.dob.age</td>
                            <td class="skill-cell">@person.skill</td>
                            <td class="hire-cell">
                                <button class="btn-heist" @onclick="() => Hire(person)">Hire</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* ---right column: who gets paid what *@
    <aside class="side-col">
        <div class="payroll">
            <p class="payroll-eyebrow">The payroll</p>
            <h2>The Crew</h2>
            <p class="payroll-count">@Plan.Crew.Count of @roles.Length hired</p>

            <ul>
                @foreach (CrewRole role in roles)
                {
                    CrewMember? member = Plan.GetCrewMember(role);
                    <li>
                        <span class="payroll-role">@CrewMember.GetRoleName(role)</span>
                        <span class="payroll-name">@(member != null ? member.Name : "Not hired")</span>
                        <span class="payroll-cut">@(member != null ? member.GetCutPercentage() + "%" : "")</span>
                    </li>
                }
            </ul>

            <div class="payroll-total">
                <span>Crew's cut</span>
                <strong>@Plan.GetTotalCutPercentage()%</strong>
            </div>
            <div class="payroll-total">
                <span>Your share</span>
                <strong>@(100 - Plan.GetTotalCutPercentage())%</strong>
            </div>

            <a href="night" class="btn-heist next-link">Next: choose the night</a>
            </div>
    </aside>

</div>

@code {
    //----ref Enum.GetValues gives back every value in the enum so we can loop through all 5 roles https://learn.microsoft.com/en-us/dotnet/api/system.enum.getvalues
    private CrewRole[] roles = Enum.GetValues<CrewRole>();
    private List<RandomUserResult> candidates = new();
    private CrewRole selectedRole = CrewRole.Hacker;
    private string? errorMessage;
    private string? hireMessage;

    //----ref OnInitialized runs when the page first loads, so candidates are there straight away https://learn.microsoft.com/en-us/aspnet/core/blazor/components/lifecycle
    //---(the docs say with prerendering it actually runs twice so the API gets called twice, doesnt break anything here)
    protected override void OnInitialized()
    {
        LoadCandidates();
    }

    private void LoadCandidates()
    {
        errorMessage = null;
        hireMessage = null;
        try
        {
            candidates = CrewService.GetCandidates(6);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            //---anything we didnt expect, show it on the page instead of crashing
            errorMessage = "Something went wrong getting candidates: " + ex.Message;
        }
    }

    private void Hire(RandomUserResult person)
    {
        CrewMember? previous = Plan.GetCrewMember(selectedRole);
        CrewMember member = CrewService.CreateCrewMember(person, selectedRole);
        Plan.Hire(member);
        candidates.Remove(person);

        string roleName = CrewMember.GetRoleName(selectedRole);
        if (previous != null)
        {
            hireMessage = $"{member.Name} replaces {previous.Name} as {roleName}.";
        }
        else
        {
            hireMessage = $"{member.Name} hired as {roleName}.";
        }
    }

    private void Fire(CrewRole role)
    {
        CrewMember? member = Plan.GetCrewMember(role);
        Plan.Fire(role);
        if (member != null)
        {
            hireMessage = $"{member.Name} has been fired.";
        }
    }
}