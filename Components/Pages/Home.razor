@page "/"

<PageTitle>Targets - Heist Planner</PageTitle>

@* ---full width painting slideshow, the paintings scroll upwards with css only (styles in app.css) *@
<section class="hero hero-tall">
    @* ---the 3 paintings are stacked on one tall strip, the first one is repeated at the end so the loop back to the start is invisible *@
    <div class="slide-track">
        <div class="slide slide-1"></div>
        <div class="slide slide-2"></div>
        <div class="slide slide-3"></div>
        <div class="slide slide-1"></div>
    </div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <p class="hero-eyebrow">The Cleveland Museum of Art</p>
        <h1>Scout the Targets</h1>
        <a href="#collection" class="hero-link">Choose up to three pieces</a>
    </div>
</section>

