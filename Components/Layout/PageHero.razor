@* ---the painting band at the top of every page, each page passes in its own words and painting
----the styles are in app.css because the hero was already there before this was a component *@
<section class="hero hero-tall @PaintingClass">
    @* ---the home page puts its slideshow in here, the other pages leave it empty *@
    @Background
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <p class="hero-eyebrow">@Eyebrow</p>
        <h1>@Title</h1>
        <a href="@LinkTarget" class="hero-link">@LinkText</a>
    </div>
</section>

@code {
    //----ref, Parameter lets the page that uses this component set these values https://learn.microsoft.com/en-us/aspnet/core/blazor/components/#component-parameters
    [Parameter] public string Eyebrow { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string LinkText { get; set; } = "";
    [Parameter] public string LinkTarget { get; set; } = "";

    //---extra css class that picks the painting, e.g. hero-crew (see app.css)
    [Parameter] public string PaintingClass { get; set; } = "";

    //----ref RenderFragment is a piece of markup passed in from the page, the home page uses it for the slideshow https://learn.microsoft.com/en-us/aspnet/core/blazor/components/#child-content-render-fragments
    [Parameter] public RenderFragment? Background { get; set; }
}